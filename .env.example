# Copy to .env and fill in real values. No secrets or real credentials belong in this file.
DATABASE_PATH=./data/alerts.db
REPORTS_DIR=./data/reports
LOG_LEVEL=INFO
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_MANAGER_URL=
WAZUH_MANAGER_USERNAME=
WAZUH_MANAGER_PASSWORD=
WAZUH_VERIFY_SSL=false
LLM_BASE_URL=http://localhost:11434/v1/
# Must be a GGUF-format Ollama model - MLX-tagged builds silently ignore
# response_format/schema-constrained generation (confirmed empirically, see PROGRESS.md).
LLM_MODEL=gemma4:12b
# The Self-Check call audits every claim in Draft-A and is by far the slowest step:
# measured at ~236s with gemma4:12b on a 13-claim draft. 120s times it out on every run.
LLM_TIMEOUT_SECONDS=600
